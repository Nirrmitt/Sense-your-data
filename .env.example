# Use OpenRouter (preferred when configured) or OpenAI.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_APP_NAME=RetailIQ

# OpenAI fallback. Set this only if you want to use OpenAI instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini

DATABASE_URL=postgresql://user:password@localhost:5432/retail_db
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
MAX_TOKENS_LIMIT=4096
STREAMLIT_SERVER_PORT=8501
